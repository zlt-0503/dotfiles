# Ignore every file by default, but keep directories visible so Git can reach
# the explicitly allowed paths below.
*
!*/

# Repository files
!/.gitignore
!/.gitattributes
!/.gitmodules
!/*.md
!/*.nix
!/*.lock
!/*.sh

# Nix-managed dotfile trees
!/config/**
!/data/**
!/home/**
!/nix/**

# Host-specific Hyprland settings
/config/hypr/machine.lua
/config/hypr/hyprpaper.conf

# Generated Fcitx5 state and user dictionaries
/config/fcitx5/conf/cached_layouts
/config/fcitx5/rime/build/
/config/fcitx5/rime/*.userdb/
/config/fcitx5/rime/*.userdb.kct

# Editor, backup, and compiled shell files
*~
*.bak
*.backup-*
*.swp
*.zwc
.DS_Store
